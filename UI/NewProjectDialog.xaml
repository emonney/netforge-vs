<Window
    x:Class="NetForge.VsExtension.UI.NewProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New NetForge Project"
    Width="580" SizeToContent="Height" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    TextOptions.TextFormattingMode="Display"
    Background="{DynamicResource NfWindowBg}" Foreground="{DynamicResource NfText}">

    <Window.Resources>
        <!-- Fallback palette (overridden at runtime by VsTheme to match the VS theme). -->
        <SolidColorBrush x:Key="NfWindowBg" Color="#252526" />
        <SolidColorBrush x:Key="NfText" Color="#F1F1F1" />
        <SolidColorBrush x:Key="NfBorder" Color="#3F3F46" />
        <SolidColorBrush x:Key="NfInputBg" Color="#1E1E1E" />
        <SolidColorBrush x:Key="Muted" Color="#9AA0A6" />
        <SolidColorBrush x:Key="Accent" Color="#6D28D9" />
        <SolidColorBrush x:Key="AccentHover" Color="#7C3AED" />

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource NfInputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource NfText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NfBorder}" />
            <Setter Property="CaretBrush" Value="{DynamicResource NfText}" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NfText}" />
        </Style>

        <!-- Fully templated so the closed selection box themes to the VS palette; the default WPF ComboBox
             chrome renders white-on-white on dark themes (unreadable). -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{DynamicResource NfText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ib" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource NfText}" />
            <Setter Property="Background" Value="{DynamicResource NfInputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NfBorder}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource NfInputBg}" BorderBrush="{DynamicResource NfBorder}"
                                                BorderThickness="1" CornerRadius="3">
                                            <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource NfText}" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,26,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource NfText}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource NfInputBg}" BorderBrush="{DynamicResource NfBorder}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource NfBorder}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Secondary" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource NfText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NfBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource Accent}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Image Source="pack://application:,,,/NetForge.VsExtension;component/Resources/logo.png"
                   Width="30" Height="30" Margin="0,0,10,0" />
            <TextBlock Text="Create a NetForge project" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="A production-shaped ASP.NET Core 10 + React 19 or Angular 22 starter."
                   Foreground="{DynamicResource Muted}" Margin="0,0,0,16" />

        <Border Style="{StaticResource Card}">
            <RadioButton x:Name="RdoCommunity" GroupName="Edition" IsChecked="True" Checked="Edition_Changed" Foreground="{DynamicResource NfText}">
                <StackPanel Margin="6,0,0,0">
                    <TextBlock FontWeight="SemiBold"><Run Text="Community" /><Run Text="  ·  Free &amp; MIT" Foreground="#9AA0A6" /></TextBlock>
                    <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                               Text="Scaffolded locally with dotnet new — auth, RBAC, an admin area, theming, and a polished UI." />
                </StackPanel>
            </RadioButton>
        </Border>

        <Border Style="{StaticResource Card}">
            <RadioButton x:Name="RdoPro" GroupName="Edition" Checked="Edition_Changed" Foreground="{DynamicResource NfText}">
                <StackPanel Margin="6,0,0,0">
                    <TextBlock FontWeight="SemiBold"><Run Text="Pro" /><Run Text="  ·  Paid plan" Foreground="#9AA0A6" /></TextBlock>
                    <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                               Text="Everything plus multi-tenancy, audit, dashboards, webhooks, search, and real-time. Get it with a Pro plan — or have AI build the whole app for you. Opens the configurator." />
                </StackPanel>
            </RadioButton>
        </Border>

        <StackPanel Margin="2,8,2,0">
            <TextBlock Text="Project name" Margin="0,0,0,4" />
            <TextBox x:Name="TxtName" Text="MyApp" TextChanged="Validate" />

            <StackPanel x:Name="LocationPanel" Margin="0,12,0,0">
                <TextBlock Text="Location" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtLocation" Grid.Column="0" TextChanged="Validate" />
                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse…" Margin="8,0,0,0"
                            Style="{StaticResource Secondary}" Click="Browse_Click" />
                </Grid>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Frontend" Margin="0,0,0,4" />
                    <ComboBox x:Name="CboFrontend" SelectedIndex="0">
                        <ComboBoxItem Content="React 19 + Vite" Tag="react" />
                        <ComboBoxItem Content="Angular 22 + Material" Tag="angular" />
                    </ComboBox>
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Database" Margin="0,0,0,4" />
                        <ComboBox x:Name="CboDatabase" SelectedIndex="0">
                            <ComboBoxItem Content="SQLite" Tag="sqlite" />
                            <ComboBoxItem Content="PostgreSQL" Tag="postgres" />
                            <ComboBoxItem Content="SQL Server" Tag="sqlserver" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Theme" Margin="0,0,0,4" />
                        <ComboBox x:Name="CboTheme" SelectedIndex="0">
                            <ComboBoxItem Content="Default" Tag="" />
                            <ComboBoxItem Content="Zinc" Tag="zinc" />
                            <ComboBoxItem Content="Ocean" Tag="ocean" />
                            <ComboBoxItem Content="Forest" Tag="forest" />
                            <ComboBoxItem Content="Sunset" Tag="sunset" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Accent colour" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ColorSwatch" Grid.Column="0" Width="30" Height="30" CornerRadius="4"
                                BorderBrush="{DynamicResource NfBorder}" BorderThickness="1" Margin="0,0,8,0" Background="Transparent" />
                        <TextBox x:Name="TxtBrandColor" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="BrandColor_Changed" />
                        <Button x:Name="BtnPickColor" Grid.Column="2" Content="Pick…" Margin="8,0,0,0"
                                Style="{StaticResource Secondary}" Click="PickColor_Click" />
                    </Grid>
                    <TextBlock Text="Optional — any CSS colour (e.g. #4f46e5). Blank uses the theme default; change it anytime at /admin/appearance."
                               Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="ValidationText" Foreground="#E06C75" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="BtnPrimary" Content="Create" Style="{StaticResource Primary}" Click="Primary_Click" />
        </StackPanel>
    </StackPanel>
</Window>
