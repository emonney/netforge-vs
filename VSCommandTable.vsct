<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="NetForge">
    <Menus>
      <!-- A top-level "NetForge" menu on the main menu bar (parented to the standard main-menu group that
           positions near Tools/Extensions). -->
      <Menu guid="NetForge" id="NetForgeMenu" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>NetForge</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="NetForge" id="NetForgeMenuGroup" priority="0x0100">
        <Parent guid="NetForge" id="NetForgeMenu" />
      </Group>
      <Group guid="NetForge" id="NetForgeLinksGroup" priority="0x0200">
        <Parent guid="NetForge" id="NetForgeMenu" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="NetForge" id="NewProject" priority="0x0100" type="Button">
        <Parent guid="NetForge" id="NetForgeMenuGroup" />
        <Strings>
          <ButtonText>New NetForge Project…</ButtonText>
        </Strings>
      </Button>
      <Button guid="NetForge" id="WhatsInPro" priority="0x0101" type="Button">
        <Parent guid="NetForge" id="NetForgeMenuGroup" />
        <Strings>
          <ButtonText>What's in Pro?</ButtonText>
        </Strings>
      </Button>
      <Button guid="NetForge" id="OpenConfigurator" priority="0x0100" type="Button">
        <Parent guid="NetForge" id="NetForgeLinksGroup" />
        <Strings>
          <ButtonText>Open the Configurator</ButtonText>
        </Strings>
      </Button>
      <Button guid="NetForge" id="OpenDemo" priority="0x0101" type="Button">
        <Parent guid="NetForge" id="NetForgeLinksGroup" />
        <Strings>
          <ButtonText>Open the Live Demo</ButtonText>
        </Strings>
      </Button>
      <Button guid="NetForge" id="OpenDocs" priority="0x0102" type="Button">
        <Parent guid="NetForge" id="NetForgeLinksGroup" />
        <Strings>
          <ButtonText>Documentation</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="NetForge" value="{6f7a1b2c-3d4e-5f60-7182-93a4b5c6d7e8}">
      <IDSymbol name="NetForgeMenu" value="0x1020" />
      <IDSymbol name="NetForgeMenuGroup" value="0x1030" />
      <IDSymbol name="NetForgeLinksGroup" value="0x1040" />
      <IDSymbol name="NewProject" value="0x0100" />
      <IDSymbol name="WhatsInPro" value="0x0101" />
      <IDSymbol name="OpenConfigurator" value="0x0102" />
      <IDSymbol name="OpenDemo" value="0x0103" />
      <IDSymbol name="OpenDocs" value="0x0104" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
